---
// Under the hero, where a logo wall would sit: the crash cases the runner is tested against, in grey,
// fading toward both ends, with one sentence that says what they are. The row is decoration for sighted
// readers; the list it shows is summed up in the sentence for everyone.
//
// Micro-interactions (hover or tap): the case darkens, its icon acts out the failure once (a bolt, a snip,
// an unplug, a full-disk shudder, a lock click; transform only, 320 ms, never repeating), and a green check
// pops onto it: the runner survives it. Under reduced motion only the colour and the check change.
import { Zap, Scissors, Unplug, HardDrive, Lock, Check } from '@lucide/svelte'

const cases = [
  { label: 'kill -9', Icon: Zap, act: 'zap', faint: true },
  { label: 'Torn writes', Icon: Scissors, act: 'snip' },
  { label: 'Lost replies', Icon: Unplug, act: 'unplug' },
  { label: 'Full disks', Icon: HardDrive, act: 'shudder' },
  { label: 'Second writers', Icon: Lock, act: 'click', faint: true },
]
---

<section class="proof" aria-label="Crash cases">
  <ul class="marks" aria-hidden="true">
    {
      cases.map(({ label, Icon, act, faint }) => (
        <li class:list={['mark', act, { faint }]}>
          <span class="icon">
            <Icon size={30} strokeWidth={1.9} />
            <span class="ok">
              <Check size={9} strokeWidth={3.4} />
            </span>
          </span>
          <span>{label}</span>
        </li>
      ))
    }
  </ul>
  <p class="caption">Tested against every documented crash case, from kill&nbsp;-9 to a second writer.</p>
</section>

<style>
  .proof {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 93px 16px 0;
  }
  .marks {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    max-width: 1088px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 40px;
    color: var(--c-mark);
    font-size: 23px;
    font-weight: 560;
    letter-spacing: -0.025em;
    white-space: nowrap;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
    transition: color 150ms ease-out;
  }
  .mark.faint {
    color: var(--c-mark-faint);
  }
  .icon {
    position: relative;
    display: grid;
    place-items: center;
  }
  .icon > :global(svg:first-child) {
    transform-origin: 50% 60%;
  }
  /* the survived check: hidden until the case is hovered or tapped */
  .ok {
    position: absolute;
    right: -5px;
    bottom: -3px;
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--c-state-done);
    box-shadow: 0 0 0 2px var(--c-page);
    color: var(--c-page);
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 150ms ease-out,
      transform 150ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .mark:hover,
  .mark:active {
    color: var(--c-ink);
  }
  .mark:hover .ok,
  .mark:active .ok {
    opacity: 1;
    transform: scale(1);
    transition-delay: 170ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    .zap:hover .icon > :global(svg:first-child),
    .zap:active .icon > :global(svg:first-child) {
      animation: act-zap 320ms ease-out 1;
    }
    .snip:hover .icon > :global(svg:first-child),
    .snip:active .icon > :global(svg:first-child) {
      animation: act-snip 320ms ease-out 1;
    }
    .unplug:hover .icon > :global(svg:first-child),
    .unplug:active .icon > :global(svg:first-child) {
      animation: act-unplug 320ms ease-out 1;
    }
    .shudder:hover .icon > :global(svg:first-child),
    .shudder:active .icon > :global(svg:first-child) {
      animation: act-shudder 320ms linear 1;
    }
    .click:hover .icon > :global(svg:first-child),
    .click:active .icon > :global(svg:first-child) {
      animation: act-click 320ms ease-out 1;
    }
  }
  @keyframes act-zap {
    0% { transform: scale(1) rotate(0); }
    30% { transform: scale(1.2) rotate(-8deg); }
    60% { transform: scale(0.92) rotate(4deg); }
    100% { transform: scale(1) rotate(0); }
  }
  @keyframes act-snip {
    0% { transform: rotate(0); }
    35% { transform: rotate(-16deg); }
    70% { transform: rotate(6deg); }
    100% { transform: rotate(0); }
  }
  @keyframes act-unplug {
    0% { transform: translate(0, 0) rotate(0); }
    40% { transform: translate(4px, -3px) rotate(10deg); }
    100% { transform: translate(0, 0) rotate(0); }
  }
  @keyframes act-shudder {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-2px); }
    40%, 80% { transform: translateX(2px); }
  }
  @keyframes act-click {
    0% { transform: translateY(0) scale(1); }
    40% { transform: translateY(-3px) scale(1); }
    70% { transform: translateY(1px) scale(1.06, 0.94); }
    100% { transform: translateY(0) scale(1); }
  }

  .caption {
    margin: 30px auto 0;
    font-size: 16.5px;
    line-height: 24px;
    letter-spacing: 0.003em;
    color: var(--c-ink-soft);
    text-align: center;
  }
  @media (max-width: 899px) {
    .proof {
      padding-top: 64px;
    }
    .marks {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 24px;
    }
    .mark {
      gap: 7px;
      height: 30px;
      font-size: 18px;
    }
    .mark.faint {
      color: var(--c-mark);
    }
    .icon > :global(svg:first-child) {
      width: 22px;
      height: 22px;
    }
    .caption {
      margin-top: 22px;
      font-size: 15.5px;
    }
  }
</style>
