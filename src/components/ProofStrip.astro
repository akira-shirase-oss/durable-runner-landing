---
// Under the hero, where a logo wall would sit: the crash cases the runner is tested against, in grey, moving
// slowly sideways as a marquee that fades out at both edges (the maintainer's call, 2026-11-24). The list is
// in the page as text for assistive tech; the moving row is decoration.
//
// The marquee is the page's one endless animation, guarded: it runs only while the strip is on screen and the
// tab is visible, pauses under the pointer (so a case can play its micro-interaction) and with the pause
// button, and never runs under reduced motion or without the script (it is paused in CSS until the script says
// it is on screen). It moves by transform only.
//
// Micro-interactions (hover or tap): the case darkens, its icon acts out the failure once (a bolt, a snip,
// an unplug, a full-disk shudder, a lock click; transform only, 320 ms, never repeating), and a green check
// pops onto it: the runner survives it. Under reduced motion only the colour and the check change.
import { Zap, Scissors, Unplug, HardDrive, Lock, Check, Pause, Play } from '@lucide/svelte'

const cases = [
  { label: 'kill -9', Icon: Zap, act: 'zap' },
  { label: 'Torn writes', Icon: Scissors, act: 'snip' },
  { label: 'Lost replies', Icon: Unplug, act: 'unplug' },
  { label: 'Full disks', Icon: HardDrive, act: 'shudder' },
  { label: 'Second writers', Icon: Lock, act: 'click' },
]
---

<section class="proof" aria-label="Crash cases">
  <p class="sr-only">
    Tested against every documented crash case: kill -9, torn writes, lost replies, full disks and second writers.
  </p>
  <div class="marquee" data-marquee>
    <div class="track" aria-hidden="true">
      {
        [0, 1].map(() => (
          <ul class="marks">
            {cases.map(({ label, Icon, act }) => (
              <li class:list={['mark', act]}>
                <span class="icon">
                  <Icon size={30} strokeWidth={1.9} />
                  <span class="ok">
                    <Check size={9} strokeWidth={3.4} />
                  </span>
                </span>
                <span>{label}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
    <button type="button" class="pause" aria-pressed="false" aria-label="Pause the moving strip" data-marquee-toggle>
      <Pause class="i-pause" size={13} strokeWidth={2.4} aria-hidden="true" />
      <Play class="i-play" size={13} strokeWidth={2.4} aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  // Run the marquee only while it is on screen and the tab is visible; the button pauses and resumes it.
  for (const strip of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
    new IntersectionObserver((entries) => strip.toggleAttribute('data-on', entries.some((e) => e.isIntersecting))).observe(strip)
    document.addEventListener('visibilitychange', () => strip.toggleAttribute('data-hidden', document.hidden))
    const button = strip.querySelector<HTMLButtonElement>('[data-marquee-toggle]')
    button?.addEventListener('click', () => {
      const paused = !strip.hasAttribute('data-paused')
      strip.toggleAttribute('data-paused', paused)
      button.setAttribute('aria-pressed', String(paused))
      button.setAttribute('aria-label', paused ? 'Play the moving strip' : 'Pause the moving strip')
    })
  }
</script>

<style>
  .proof {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 93px 16px 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* the marquee: two identical rows side by side; moving the pair by half its width loops seamlessly */
  .marquee {
    position: relative;
    max-width: 1088px;
    margin: 0 auto;
    overflow: hidden;
  }
  .marquee::before,
  .marquee::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 140px;
    pointer-events: none;
  }
  .marquee::before {
    left: 0;
    background: linear-gradient(90deg, var(--c-page), transparent);
  }
  .marquee::after {
    right: 0;
    background: linear-gradient(270deg, var(--c-page), transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: proof-marquee 38s linear infinite paused;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee[data-on]:not([data-paused]):not([data-hidden]):not(:hover) .track {
      animation-play-state: running;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .pause {
      display: none;
    }
  }
  @keyframes proof-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marks {
    display: flex;
    align-items: center;
    gap: 76px;
    margin: 0;
    padding: 0 76px 0 0;
    list-style: none;
  }
  .pause {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 2;
    margin-top: -15px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--c-mark);
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }
  .pause:hover {
    background: var(--c-hover);
    color: var(--c-ink);
  }
  .pause :global(.i-play),
  .pause[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }
  .pause[aria-pressed='true'] :global(.i-play) {
    display: block;
  }
  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 40px;
    color: var(--c-mark);
    font-size: 23px;
    font-weight: 560;
    letter-spacing: -0.025em;
    white-space: nowrap;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
    transition: color 150ms ease-out;
  }
  .icon {
    position: relative;
    display: grid;
    place-items: center;
  }
  .icon > :global(svg:first-child) {
    transform-origin: 50% 60%;
  }
  /* the survived check: hidden until the case is hovered or tapped */
  .ok {
    position: absolute;
    right: -5px;
    bottom: -3px;
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--c-state-done);
    box-shadow: 0 0 0 2px var(--c-page);
    color: var(--c-page);
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 150ms ease-out,
      transform 150ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .mark:hover,
  .mark:active {
    color: var(--c-ink);
  }
  .mark:hover .ok,
  .mark:active .ok {
    opacity: 1;
    transform: scale(1);
    transition-delay: 170ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    .zap:hover .icon > :global(svg:first-child),
    .zap:active .icon > :global(svg:first-child) {
      animation: act-zap 320ms ease-out 1;
    }
    .snip:hover .icon > :global(svg:first-child),
    .snip:active .icon > :global(svg:first-child) {
      animation: act-snip 320ms ease-out 1;
    }
    .unplug:hover .icon > :global(svg:first-child),
    .unplug:active .icon > :global(svg:first-child) {
      animation: act-unplug 320ms ease-out 1;
    }
    .shudder:hover .icon > :global(svg:first-child),
    .shudder:active .icon > :global(svg:first-child) {
      animation: act-shudder 320ms linear 1;
    }
    .click:hover .icon > :global(svg:first-child),
    .click:active .icon > :global(svg:first-child) {
      animation: act-click 320ms ease-out 1;
    }
  }
  @keyframes act-zap {
    0% { transform: scale(1) rotate(0); }
    30% { transform: scale(1.2) rotate(-8deg); }
    60% { transform: scale(0.92) rotate(4deg); }
    100% { transform: scale(1) rotate(0); }
  }
  @keyframes act-snip {
    0% { transform: rotate(0); }
    35% { transform: rotate(-16deg); }
    70% { transform: rotate(6deg); }
    100% { transform: rotate(0); }
  }
  @keyframes act-unplug {
    0% { transform: translate(0, 0) rotate(0); }
    40% { transform: translate(4px, -3px) rotate(10deg); }
    100% { transform: translate(0, 0) rotate(0); }
  }
  @keyframes act-shudder {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-2px); }
    40%, 80% { transform: translateX(2px); }
  }
  @keyframes act-click {
    0% { transform: translateY(0) scale(1); }
    40% { transform: translateY(-3px) scale(1); }
    70% { transform: translateY(1px) scale(1.06, 0.94); }
    100% { transform: translateY(0) scale(1); }
  }

  @media (max-width: 899px) {
    .proof {
      padding-top: 64px;
    }
    .marks {
      gap: 44px;
      padding-right: 44px;
    }
    .mark {
      gap: 7px;
      height: 32px;
      font-size: 18px;
    }
    .icon > :global(svg:first-child) {
      width: 22px;
      height: 22px;
    }
    .marquee::before,
    .marquee::after {
      width: 56px;
    }
    .track {
      animation-duration: 28s;
    }
  }
</style>
