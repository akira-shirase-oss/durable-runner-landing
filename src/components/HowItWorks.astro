---
import SectionHeading from './ui/SectionHeading.astro'
import { DOCS_URL } from '../data/app'
import styles from './HowItWorks.module.css'

// The durable-accept loop in four steps — what happens between "submit" and "done".
const steps = [
  {
    n: '1',
    title: 'Submit',
    body: 'Post a job: an op_key, named steps and a small input — from the CLI or plain curl.',
  },
  {
    n: '2',
    title: 'Commit',
    body: 'The record is appended to the journal and fsynced — the ack only goes out after it is durable.',
  },
  {
    n: '3',
    title: 'Dispatch',
    body: 'Each step calls the HTTP handler it names — and only handlers registered at startup.',
  },
  {
    n: '4',
    title: 'Finish or retry',
    body: 'The outcome is journaled; a retry runs under the same idempotency key, after reconciling what actually happened.',
  },
]
---

<section class="section" id="how">
  <div class={`container ${styles.inner}`}>
    <SectionHeading badge="The loop" align="center" width={720}>
      How a job<br /><span class="soft">becomes durable</span>
    </SectionHeading>
    <ol class={styles.steps}>
      {
        steps.map((s, i) => (
          <li class={styles.step}>
            <span class={styles.n} aria-hidden="true">{s.n}</span>
            <h3 class={styles.title}>{s.title}</h3>
            <p class={styles.body}>{s.body}</p>
            {i < steps.length - 1 && (
              <svg class={styles.arrow} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            )}
          </li>
        ))
      }
    </ol>
    <p class={styles.more}>
      The full execution model lives in <a class="inline-link" href={`${DOCS_URL}/concepts/`}>concepts</a>.
    </p>
  </div>
</section>
