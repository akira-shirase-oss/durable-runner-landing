---
// The hero: the badge, the three-verb headline with the app icon set in it, the one-line promise, and the
// stage: a landscape panel holding the two cards, with the phone rising out of its top edge.
// At 1000 px and up the cards sit on the landscape; below, the panel holds the phone and the cards follow it.
import AppIcon from './AppIcon.astro'
import PhoneMock from './PhoneMock.astro'
import IntroCard from './IntroCard.astro'
import StoryCard from './StoryCard.astro'
import { Badge } from '$lib/components/ui/badge'
import { hero } from '../data/hero'
---

<section class="hero" aria-labelledby="hero-title">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col items-center px-4">
    <Badge
      variant="outline"
      class="h-[30px] rounded-[9px] border-line bg-card px-[11px] text-[14.5px] font-normal tracking-[0.003em] text-ink"
    >
      {hero.badge}
    </Badge>

    <h1 id="hero-title" class="title">
      <span class="line">{hero.lines[0]} <AppIcon size={52} class="inline-icon" /> {hero.lines[1]}</span>
      <span class="line">{hero.lines[2]}</span>
    </h1>

    <p class="lede">{hero.description}</p>

    <div class="stage">
      <div class="panel">
        <div class="slot left"><IntroCard /></div>
        <div class="slot right"><StoryCard /></div>
      </div>
      <div class="phone-slot">
        <PhoneMock />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 64px;
  }
  .title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 24px 0 0;
    font-size: 64px;
    font-weight: 480;
    line-height: 75px;
    letter-spacing: -0.018em;
    color: var(--c-ink);
    text-align: center;
  }
  .line {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .title :global(.inline-icon) {
    margin: 0 13px 0 14px;
    transform: translateY(-5px);
  }
  .lede {
    max-width: 396px;
    margin: 9px 0 0;
    font-size: 16.5px;
    line-height: 23.5px;
    letter-spacing: 0.003em;
    color: var(--c-body);
    text-align: center;
  }

  /* the stage: panel + phone */
  .stage {
    position: relative;
    width: 100%;
    margin-top: 94px;
  }
  .panel {
    display: flex;
    justify-content: space-between;
    height: 443px;
    padding: 47px;
    border-radius: 48px;
    background-color: var(--c-sky);
    background-image: var(--img-landscape);
    background-size: cover;
    background-position: center;
  }
  .slot {
    width: 290px;
  }
  .slot.right {
    width: 291px;
  }
  .slot > :global(*),
  .slot :global(.story) {
    height: 100%;
  }
  .phone-slot {
    position: absolute;
    left: 50%;
    top: -52px;
    bottom: 0;
    width: 364px;
    margin-left: -182px;
    clip-path: inset(-20px -60px 0 -60px);
  }

  @media (max-width: 1199px) {
    .panel {
      padding: 28px;
    }
    .slot,
    .slot.right {
      width: calc((100% - 364px - 40px) / 2);
    }
  }

  @media (max-width: 999px) {
    .stage {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 64px;
    }
    .panel {
      display: contents;
    }
    .phone-slot {
      position: relative;
      left: auto;
      top: auto;
      order: -1;
      width: 100%;
      height: 443px;
      margin: 0;
      padding-top: 52px;
      clip-path: inset(0 0 0 0 round 0 0 40px 40px);
    }
    .phone-slot::before {
      content: '';
      position: absolute;
      inset: 52px 0 0;
      border-radius: 40px;
      background-color: var(--c-sky);
      background-image: var(--img-landscape);
      background-size: cover;
      background-position: center;
    }
    .phone-slot :global(.phone) {
      position: relative;
      margin: -52px auto 0;
      transform-origin: top center;
    }
    .slot,
    .slot.right {
      width: 100%;
    }
    .slot > :global(*),
    .slot :global(.story) {
      border: 1px solid var(--c-line);
    }
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .stage {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .phone-slot {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding-top: 40px;
    }
    .title {
      margin-top: 20px;
      font-size: 40px;
      line-height: 48px;
      letter-spacing: -0.028em;
    }
    .title :global(.inline-icon) {
      width: 34px;
      height: 34px;
      border-radius: 10px;
    }
    .lede {
      margin-top: 16px;
      font-size: 16px;
    }
    .phone-slot {
      height: 400px;
    }
    .phone-slot :global(.phone) {
      zoom: 0.84;
    }
  }
</style>
