---
import styles from './Surfaces.module.css'

// The ways in and out: one runner, reached three ways plus the endpoints it is allowed to call
// (lucide-style glyphs, one stroke and size)
const surfaces = [
  { label: 'CLI', icon: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>' },
  {
    label: 'HTTP API',
    icon: '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  },
  {
    label: 'Inspector',
    icon: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M8 21v-8"/>',
  },
  {
    label: 'Allowlisted handlers',
    icon: '<path d="M10 12.5 8 15l2 2.5"/><path d="m14 12.5 2 2.5-2 2.5"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/>',
  },
]
---

<section class={`section ${styles.strip}`}>
  <div class={`container ${styles.inner}`}>
    <h2 class="visually-hidden">One runner, reached through the CLI, the HTTP API and the Inspector, calling only registered handlers</h2>
    <ul class={styles.surfaces}>
      {
        surfaces.map((x) => (
          <li class={styles.surface}>
            <span class={styles.icon} aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={x.icon}
              />
            </span>
            <span class={styles.label}>{x.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
