---
import styles from './WhatItIs.module.css'

// "What it is": four quiet cards, the same visual pattern as the family's benefit grid — a raised
// neutral tile icon, a two-line body, a status chip. The copy is the product's own contract:
// journal-first acknowledgement, at-least-once honestly, bounded everything, the Inspector.
const items = [
  {
    title: 'Accepted means durable',
    tag: 'Journal-first',
    lines: [
      'A run is acknowledged only after its record is durable in the journal on disk.',
      'The in-memory index is rebuilt from it at startup — never the authority.',
    ],
    icon: '<path d="M3 12h4l3-9 4 18 3-9h4"/>',
    color: 'blue',
  },
  {
    title: 'At-least-once, honestly',
    tag: 'One key per attempt',
    lines: [
      'Every attempt of a step runs under one business idempotency key.',
      'A lost handler reply is reconciled before retrying — external exactly-once is never claimed.',
    ],
    icon: '<path d="M3 12a9 9 0 0 1 15.36-6.36L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.36 6.36L3 16"/><path d="M3 21v-5h5"/>',
    color: 'green',
  },
  {
    title: 'Every limit enforced',
    tag: 'Bounded',
    lines: [
      'Queues, payloads, retries, live runs, memory, disk, connections, client addresses.',
      'Admission is refused before a reserve runs out — the numbers are configuration, not hopes.',
    ],
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
    color: 'pink',
  },
  {
    title: 'The whole runner, visible',
    tag: 'Inspector',
    lines: [
      'Runs, jobs, submit, cancel, compact, backup and diagnostics — one small UI at /inspector.',
      'Served same-origin by the runner; keys stay in sessionStorage.',
    ],
    icon: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
    color: 'blueSoft',
  },
]
---

<section class="section" id="what">
  <div class={`container ${styles.inner}`}>
    <h2 class="visually-hidden">What Durable Runner is</h2>
    <ul class={styles.grid}>
      {
        items.map((x, i) => (
          <li class={styles.card} style={`--i:${i}`}>
            <div class={styles.titleRow}>
              <span class={styles.icon} aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="26"
                  height="26"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={x.icon}
                />
              </span>
              <h3 class={`t-h5 ${styles.h}`}>{x.title}</h3>
            </div>
            <p class={styles.body}>
              {x.lines.map((line) => (
                <span>{line}</span>
              ))}
            </p>
            <span class={`${styles.tag} ${styles[x.color]}`}>
              <span class={styles.dot} aria-hidden="true" />
              {x.tag}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
