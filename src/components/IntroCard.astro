---
// The hero's left card: the promise, the run states as an overlapping stack, the evidence, one action.
import * as Card from '$lib/components/ui/card'
import { Button } from '$lib/components/ui/button'
import { Clock, Play, RotateCcw, ScanSearch, Check, SquareTerminal } from '@lucide/svelte'
import { DOCS_URL } from '../data/app'

const states = [
  { name: 'Queued', tone: 'queued', Icon: Clock },
  { name: 'Running', tone: 'run', Icon: Play },
  { name: 'Waiting to retry', tone: 'retry', Icon: RotateCcw },
  { name: 'Reconciling', tone: 'probe', Icon: ScanSearch },
  { name: 'Done', tone: 'done', Icon: Check },
]
---

<Card.Root class="intro gap-0 rounded-[28px] bg-card p-[23px] pb-[23px] text-ink ring-0 shadow-[inset_0_0_0_1px_var(--c-card-edge)]">
  <h2 class="text-[32.5px] font-[420] leading-[40px] tracking-[-0.022em] text-ink">Crash It.<br />Lose Nothing.</h2>

  <div class="mt-[23px] flex items-center pl-[5px]" role="img" aria-label="Five of a run's seven states: queued, running, waiting to retry, reconciling and done; failed and cancelled are the other two.">
    {
      states.map(({ tone, Icon }) => (
        <span class={`state ${tone}`} aria-hidden="true">
          <Icon size={19} strokeWidth={2} />
        </span>
      ))
    }
    <span class="more" aria-hidden="true">+2</span>
  </div>

  <p class="mt-[22px] text-[16px] leading-[23.5px] tracking-[0.002em] text-body">
    Every state change is journaled first, so 36 kill&nbsp;-9s under load lost 0 acked runs.
  </p>

  <Button href={`${DOCS_URL}/quick-start/`} class="mt-[17px] w-fit">
    <SquareTerminal strokeWidth={1.8} aria-hidden="true" />
    Start for Free
  </Button>
</Card.Root>

<style>
  .state,
  .more {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    margin-right: -7px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--c-ring);
  }
  .more {
    position: relative;
    background: var(--c-card);
    box-shadow:
      0 0 0 2px var(--c-ring),
      inset 0 0 0 1px var(--c-line);
    font-size: 14px;
    color: var(--c-ink);
  }
  .state {
    position: relative;
  }
  .queued {
    background: var(--c-state-queued-bg);
    color: var(--c-state-queued);
  }
  .run {
    background: var(--c-state-run-bg);
    color: var(--c-state-run);
  }
  .retry {
    background: var(--c-state-retry-bg);
    color: var(--c-state-retry);
  }
  .probe {
    background: var(--c-state-probe-bg);
    color: var(--c-state-probe);
  }
  .done {
    background: var(--c-state-done-bg);
    color: var(--c-state-done);
  }
  /* 1000–1199 px: the cards narrow around the phone, so the stack tightens to fit */
  @media (min-width: 1000px) and (max-width: 1199px) {
    .state,
    .more {
      width: 40px;
      height: 40px;
      margin-right: -9px;
    }
    .state :global(svg) {
      width: 17px;
      height: 17px;
    }
  }
</style>
