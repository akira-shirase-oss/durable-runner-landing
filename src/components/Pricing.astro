---
// Pricing: two honest plans side by side. Self-hosted is free and MIT licensed today; the hosted cloud
// is not open yet — it will be free while it is in beta, and its limits are measured and published
// before sign-ups open (there is no sign-up link: there is no app). Every line states a fact or a
// dated intention, never a number the service has not measured.
// Motion is the shared play-in-view: the cards rise once, the "Opening soon" badge pops in after them;
// hovering or tapping a card replays a small nudge. Reduced motion, or no script, shows the finished state.
import * as Card from '$lib/components/ui/card'
import { Button } from '$lib/components/ui/button'
import { SquareTerminal, Github, Check, Clock } from '@lucide/svelte'
import { DOCS_URL, REPO } from '../data/app'

const plans = [
  {
    name: 'Self-hosted',
    price: 'Free',
    term: 'MIT licensed',
    note: 'Runs on your own machine, today.',
    features: [
      'One binary — no services to run alongside it',
      'The journal lives on your disk',
      'The Inspector dashboard, built in',
      'Backups and restore drills included',
      'Every feature — nothing behind a tier',
    ],
    cta: { label: 'Read the quick start', href: `${DOCS_URL}/quick-start/`, variant: 'default' as const, Icon: SquareTerminal },
  },
  {
    name: 'Cloud',
    price: 'Free',
    term: 'during the beta',
    soon: 'Opening soon',
    note: 'The same runner, hosted by the project.',
    features: [
      'Accounts and workspaces for a team',
      'A hosted dashboard — no server to run',
      'A handler registry with signed calls',
      'Managed backups',
    ],
    honest: 'Limits will be measured and published before sign-ups open.',
    cta: { label: 'Follow progress', href: REPO, variant: 'outline' as const, Icon: Github },
  },
]
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title" data-play-section>
  <header class="head">
    <p class="eyebrow">Pricing</p>
    <h2 id="pricing-title">Free today, free in the beta</h2>
    <p class="lede">
      Run the open-source runner on your own hardware, or take a seat in the hosted beta when it opens.
      There are no paid plans yet.
    </p>
  </header>

  <div class="plans">
    {
      plans.map(({ name, price, term, soon, note, features, honest, cta }, i) => (
        <Card.Root class="plan gap-0 rounded-[30px] p-0 ring-0" style={`--i:${i}`} data-tile>
          <div class="top">
            <div class="name-row">
              <h3>{name}</h3>
              {soon && (
                <span class="soon">
                  <Clock size={12} strokeWidth={2.2} aria-hidden="true" />
                  {soon}
                </span>
              )}
            </div>
            <p class="price">
              {price} <span class="term">{term}</span>
            </p>
            <p class="note">{note}</p>
          </div>
          <ul class="features">
            {features.map((f) => (
              <li>
                <Check size={15} strokeWidth={2.4} aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
          {honest && <p class="honest">{honest}</p>}
          <Button href={cta.href} variant={cta.variant} class="cta mt-auto w-fit">
            <cta.Icon strokeWidth={1.8} aria-hidden="true" />
            {cta.label}
          </Button>
        </Card.Root>
      ))
    }
  </div>
</section>

<script>
  import '../scripts/play-in-view'
</script>

<style>
  .pricing {
    width: 100%;
    max-width: 1200px;
    margin: 128px auto 0;
    padding: 0 16px;
  }
  .head {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--c-brand-deep);
  }
  h2 {
    margin: 10px 0 0;
    font-size: 46px;
    font-weight: 480;
    line-height: 54px;
    letter-spacing: -0.03em;
    color: var(--c-ink);
  }
  .lede {
    margin: 16px auto 0;
    max-width: 600px;
    font-size: 17px;
    line-height: 26px;
    letter-spacing: 0.002em;
    color: var(--c-body);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 940px;
    margin: 56px auto 0;
  }
  .pricing :global(.plan) {
    display: flex;
    flex-direction: column;
    padding: 30px;
    background: var(--c-card);
    box-shadow:
      inset 0 0 0 1px var(--c-line),
      0 18px 40px -24px var(--c-shadow);
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .name-row h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 400;
    line-height: 30px;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border-radius: 13px;
    background: var(--c-brand-tint);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--c-brand-deep);
    white-space: nowrap;
  }
  .price {
    margin: 18px 0 0;
    font-size: 42px;
    font-weight: 550;
    line-height: 46px;
    letter-spacing: -0.025em;
    color: var(--c-ink);
  }
  .price .term {
    font-size: 16px;
    font-weight: 450;
    letter-spacing: 0;
    color: var(--c-body);
  }
  .note {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 22px;
    color: var(--c-body);
  }
  .features {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    line-height: 22px;
    color: var(--c-ink-soft);
  }
  .features :global(svg) {
    position: relative;
    top: 2px;
    flex-shrink: 0;
    color: var(--c-brand-deep);
  }
  .honest {
    margin: 18px 0 0;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--c-surface);
    font-size: 13.5px;
    line-height: 19px;
    color: var(--c-body);
  }
  .pricing :global(.cta) {
    margin-top: 28px;
  }
  /* keep the button at the bottom when the other card is taller */
  .features {
    margin-bottom: 4px;
  }

  /* the entrance: cards wait while armed, rise once on 'in', and the badge pops in behind them */
  @media (prefers-reduced-motion: no-preference) {
    .pricing[data-play='armed'] :global(.plan) {
      opacity: 0;
    }
    .pricing[data-play='in'] :global(.plan) {
      animation: price-rise 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--i) * 110ms);
    }
    .pricing[data-play='armed'] .soon {
      opacity: 0;
    }
    .pricing[data-play='in'] .soon {
      animation: price-pop 300ms cubic-bezier(0.3, 1.5, 0.5, 1) 560ms both;
    }
    /* a hover or tap replay nudges the card; nothing hides */
    .pricing :global(.plan[data-replay]) {
      animation: price-nudge 320ms ease-out both;
    }
    .pricing :global(.plan[data-replay]) .soon {
      animation: price-pop 300ms cubic-bezier(0.3, 1.5, 0.5, 1) both;
    }
  }
  @keyframes price-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes price-pop {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes price-nudge {
    0%,
    100% {
      transform: none;
    }
    40% {
      transform: translateY(-3px);
    }
  }

  @media (max-width: 999px) {
    .pricing {
      margin-top: 96px;
    }
  }
  @media (max-width: 639px) {
    .pricing {
      margin-top: 80px;
    }
    .plans {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 40px;
    }
    h2 {
      font-size: 36px;
      line-height: 43px;
    }
    .lede {
      font-size: 16px;
      line-height: 24px;
    }
    .price {
      font-size: 36px;
      line-height: 40px;
    }
  }
</style>
