---
import { DOCS_URL, REPO } from '../data/app'
import MaskIcon from './ui/MaskIcon.astro'
import BrandLogo from './ui/BrandLogo.astro'
import BrandWordmark from './ui/BrandWordmark.astro'
import styles from './Footer.module.css'

// No hosted app, contact address, privacy or terms page exists, so the footer links only to what does.
const columns = [
  {
    title: 'Product',
    links: [
      { label: 'What it is', href: '/#what' },
      { label: 'The proof', href: '/#proof' },
      { label: 'How it works', href: '/#how' },
      { label: 'Quick start', href: '/#quickstart' },
    ],
  },
  {
    title: 'Build',
    links: [
      { label: 'Docs', href: DOCS_URL },
      { label: 'Changelog', href: `${DOCS_URL}/changelog/` },
      { label: 'Source code', href: REPO },
      { label: 'Open an issue', href: `${REPO}/issues` },
    ],
  },
]

// Prints the pixel wordmark once, row by row, when the footer first comes into view (only if it starts below
// the fold and motion is allowed). It watches the word's frame, because the clipped word itself never counts
// as in view. Without this script the word simply stands there.
const PRINT =
  "var w=document.querySelector('[data-wordmark]');if(w&&'IntersectionObserver'in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches&&w.getBoundingClientRect().top>innerHeight){w.dataset.print='armed';var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){o.disconnect();requestAnimationFrame(function(){w.dataset.print='go'})}},{threshold:0.3});o.observe(w.parentElement)}"

const socials = [
  { icon: '/icons/x.svg', label: 'Durable Runner on X', href: 'https://x.com/404humandev' },
  { icon: '/icons/github.svg', label: 'Durable Runner on GitHub', href: REPO },
]
---

<footer class={styles.footer}>
  <div class={styles.inner}>
    <div class={styles.top}>
      <a href="/" aria-label="Durable Runner home">
        <BrandLogo />
      </a>
      <div class={styles.social}>
        <p class="t-tiny">Social media</p>
        <div class={styles.socialButtons}>
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} class={styles.socialBtn}>
                <MaskIcon src={s.icon} size={24} color="var(--c-ink)" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class={styles.links}>
      <p class={`t-tiny ${styles.tagline}`}>
        A background-task runner where accepting a job is a durable commit: the journal is the only
        authority, acknowledged work survives restarts, and every limit is bounded.
      </p>
      <nav class={styles.menu} aria-label="Footer">
        {
          columns.map((c) => (
            <div class={styles.column}>
              <p class={`t-label ${styles.colTitle}`}>
                <span class={styles.square} aria-hidden="true" />
                {c.title}
              </p>
              {c.links.map((l) => (
                <a href={l.href} class={`t-tiny ${styles.link}`}>
                  {l.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </div>

    <div class={styles.legal}>
      <p class="t-small">© 2026 Durable Runner&nbsp;· <span class={styles.keep}>Made with <a href={REPO}>Rust and a journal</a></span></p>
      <p class={`t-small ${styles.imprint}`}>Set in Geist Pixel and Inter</p>
    </div>
    <div class={styles.wordmark}>
      <BrandWordmark class={styles.wordmarkImg} />
    </div>
  </div>
</footer>
<script is:inline set:html={PRINT} />
