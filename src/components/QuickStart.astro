---
import { Code } from 'astro:components'
import SectionHeading from './ui/SectionHeading.astro'
import { aaOnSurface } from '../lib/shiki'
import { DOCS_URL } from '../data/app'
import styles from './QuickStart.module.css'

// The commands are the docs' own quick start, verbatim — they build a real server on 127.0.0.1
// and submit a real job. The page only trims the between-command prose.
const themes = { light: 'github-light-default', dark: 'github-dark-default' } as const

const blocks = [
  {
    label: 'Build it — from source, the only way today',
    lang: 'sh',
    code: `test -d durable-runner || git clone https://github.com/akira-shirase-oss/durable-runner.git
cd durable-runner
cargo build --release --locked -p durable-server -p durable-cli`,
  },
  {
    label: 'Run it — one handler, one server',
    lang: 'sh',
    code: `export DURABLE_API_KEY=$(openssl rand -hex 32)
export DURABLE_READ_KEY=$(openssl rand -hex 32)
rm -rf journal backups   # a clean journal for this walkthrough
python3 examples/pilot/handler.py 58320 >handler.log 2>&1 &
HND=$!
./target/release/durable-server --journal journal --listen 127.0.0.1:58300 \\
  --backup-root backups --handler step=http://127.0.0.1:58320/step >server.log 2>&1 &
SRV=$!
for i in $(seq 1 150); do curl -sf http://127.0.0.1:58300/health >/dev/null && break; kill -0 $SRV 2>/dev/null || { echo "server died; check server.log"; break; }; sleep 0.1; done
export PATH="$PWD/target/release:$PATH"
alias durable="durable-cli --server http://127.0.0.1:58300"`,
  },
  {
    label: 'Submit and inspect — the ack is a durable commit',
    lang: 'sh',
    code: `durable submit --op-key demo/first-job --step greet=step --input '{"name":"ada"}'
durable inspect --run 1`,
  },
]
---

<section class="section" id="quickstart">
  <div class={`container ${styles.inner}`}>
    <SectionHeading badge="From source" align="center" width={720}>
      Quick start,<br /><span class="soft">the real commands</span>
    </SectionHeading>
    <div class={styles.blocks}>
      {
        blocks.map((b) => (
          <div class={styles.block}>
            <p class={styles.label}>{b.label}</p>
            <Code
              code={b.code}
              lang={b.lang}
              themes={themes}
              defaultColor={false}
              transformers={[aaOnSurface]}
              class={styles.code}
            />
          </div>
        ))
      }
    </div>
    <p class={styles.more}>
      Every step explained — and the API version of each call — in the{' '}
      <a class="inline-link" href={`${DOCS_URL}/quick-start/`}>quick start</a>. Pre-release: built
      from source, no binaries yet.
    </p>
  </div>
</section>
