---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Surfaces from '../components/Surfaces.astro'
import WhatItIs from '../components/WhatItIs.astro'
import Proof from '../components/Proof.astro'
import HowItWorks from '../components/HowItWorks.astro'
import QuickStart from '../components/QuickStart.astro'
import CTA from '../components/CTA.astro'
import Footer from '../components/Footer.astro'
import { hero } from '../data/hero'
import { REPO } from '../data/app'

const title = `Durable Runner | ${hero.headline.replace(/\.$/, '')}`
const description = hero.description
---

<Base
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Durable Runner',
      url: Astro.site?.href,
      description,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Durable Runner',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS',
      url: Astro.site?.href,
      codeRepository: REPO,
      description,
      isAccessibleForFree: true,
    },
  ]}
>
  <div id="root">
    <div style="display: flex; flex-direction: column; align-items: center; overflow: clip;">
      <Nav />
      <main style="width: 100%; display: flex; flex-direction: column; align-items: center; margin-top: 1px; gap: var(--section-gap); padding-bottom: var(--section-gap);">
        <Hero />
        <Surfaces />
        <WhatItIs />
        <Proof />
        <HowItWorks />
        <QuickStart />
        <CTA />
      </main>
      <Footer />
    </div>
  </div>
</Base>
