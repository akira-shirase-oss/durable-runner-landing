---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { DOCS_URL } from '../data/app'
import styles from './404.module.css'

const title = 'Page not found | Durable Runner'
const description = 'There is no page at this address. The home page and the docs are a click away.'
---

<Base title={title} description={description} noindex>
  <div style="display: flex; flex-direction: column; align-items: center; overflow: clip;">
    <Nav />
    <main class={styles.page}>
      <div class="container">
        <header class={styles.head}>
          <p class="t-badge">404</p>
          <h1 class="t-h2">There's no page here</h1>
          <p class={`t-body ${styles.lede}`}>
            The address may be mistyped, or the page may have moved. Try the <a href="/">home page</a> or
            the <a href={DOCS_URL}>docs</a>.
          </p>
        </header>
      </div>
    </main>
    <Footer />
  </div>
</Base>
